{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/phac-nml/snvphylnfc/main/assets/schema_output.json",
    "title": "SNVPhyl NFC Output Schema",
    "description": "The SNVPhyl NFC-specific schema used for validating IRIDA Next JSON output data",
    "type": "object",
    "properties": {
        "files": {
            "type": "object",
            "properties": {
                "global": {
                    "type": "array",
                    "items": {
                        "properties": {
                            "path": {
                                "anyOf": [
                                    {
                                        "pattern": "^.*pipeline_info/.*software_versions.yml$",
                                        "description": "Software versions used by the pipeline."
                                    },
                                    {
                                        "pattern": "^.*arbor/.*SNVPhyl_ArborView.html$",
                                        "description": "An HTML file generated by ArborView for examining the phylogenetic tree dendrogram."
                                    },
                                    {
                                        "pattern": "^.*make/.*snvMatrix.tsv$",
                                        "description": "A pairwise distance matrix of SNVs that passed all filtering criteria."
                                    },
                                    {
                                        "pattern": "^.*filter/.*filterStats.txt$",
                                        "description": "A summary of the number of SNVs filtered within in the SNV Table."
                                    },
                                    {
                                        "pattern": "^.*phyml/.*phylogeneticTreeStats.txt$",
                                        "description": "Statistics for the generated phylogenetic tree."
                                    },
                                    {
                                        "pattern": "^.*phyml/.*phylogeneticTree.newick$",
                                        "description": "The maximum likelihood phylogeny generated from an alignment of SNVs extracted from the whole genomes of each input file."
                                    },
                                    {
                                        "pattern": "^.*vcf2snv/.*snvTable.tsv$",
                                        "description": "A table of all detected variant sites."
                                    },
                                    {
                                        "pattern": "^.*vcf2snv/.*vcf2core.tsv$",
                                        "description": "A table of the evaluated core positions in each reference fasta sequence."
                                    },
                                    {
                                        "pattern": "^.*vcf2snv/.*snvAlignment.phy$",
                                        "description": "An alignment of SNVs used to generate the phylogenetic tree."
                                    },
                                    {
                                        "pattern": "^.*verifying/.*mappingQuality.txt$",
                                        "description": "Describes how well the given reads mapped to the reference genome."
                                    },
                                    {
                                        "pattern": "^.*error/.*max_samples_exceeded.error.txt$",
                                        "description": "A file generated for debugging purposes. The file is generated when the number of samples passed to the pipeline exceeds the maximum number of samples."
                                    }
                                ]
                            }
                        },
                        "additionalProperties": false
                    },
                    "uniqueItems": true
                },
                "samples": {
                    "type": "object",
                    "patternProperties": {
                        "^.*$": {
                            "type": "array",
                            "items": {
                                "properties": {},
                                "additionalProperties": false
                            },
                            "uniqueItems": true
                        }
                    }
                }
            }
        },
        "metadata": {
            "type": "object",
            "properties": {
                "samples": {
                    "type": "object",
                    "patternProperties": {
                        "^.*$": {
                            "type": "object",
                            "properties": {},
                            "additionalProperties": false
                        }
                    }
                }
            }
        }
    }
}
